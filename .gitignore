# 1. 데이터 폴더와 파일을 무시합니다.
DATA/
*.npz
*.csv
*.xlsx
*.bag

# 2. 파이썬 캐시 및 환경 파일을 무시합니다.
__pycache__/
*.pyc
venv/
.env/

# 3. VS Code 설정 파일을 무시합니다.
.vscode/

# 4. (나중에 사용할 수 있는) 기타 데이터 파일
*.png
*.txt

# 5. 예외 규칙 (results 폴더는 추적)
!outputs/1. loss_graph/*.png
!outputs/2. train_pred_true_graph/**/*.png
!outputs/3. test_pred_true_graph/**/*.png
!outputs/4. config/**/*.yaml
!outputs/6. weights/**/*.pth
!outputs/5. loss_csv/*.csv
outputs/*.pthoutputs/
